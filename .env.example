# =================================================================
# NIGOTO HUB - CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH CHO SELF-HOSTING
# =================================================================

# 1. Tên miền riêng của bạn (Bắt buộc)
# Ví dụ: https://hub.clb-nigoto.com hoặc http://localhost:8080 nếu test nội bộ
BETTER_AUTH_URL=https://hub.clb-nigoto.com

# 2. Chuỗi bí mật mã hóa phiên đăng nhập (Bắt buộc, tối thiểu 32 ký tự)
# Bạn có thể gõ ngẫu nhiên bất kỳ chuỗi dài nào
BETTER_AUTH_SECRET=nigoto_hub_secret_key_change_me_to_a_long_random_string_123456

# 3. Kết nối Cơ sở dữ liệu PostgreSQL (Khuyến nghị cho self-host lâu dài)
# Để trống nếu muốn chạy tạm thời bằng PGLite (in-memory)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nigoto_hub

# 4. Cấu hình Server (Tùy chọn)
PORT=8080
HOST=0.0.0.0
